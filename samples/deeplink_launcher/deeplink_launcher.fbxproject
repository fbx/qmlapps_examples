import QmlProject 1.1

Project {
    mainFile: "main.qml"

    QmlFiles {
        directory: "."
    }

    JavaScriptFiles {
        directory: "."
    }

    ImageFiles {
        directory: "."
    }

    Files {
        filter: "qmldir;*.ttf;*.otf;*.woff"
        directory: "."
        recursive: true
    }

    Files {
        filter: "manifest.json"
    }
}
